          },
          {
            "v": "S021, S022, S023, S024, S025, S026, S027, S040, S041, S042, S043, S044, S045",
            "s": "10",
            "r": "C8"
          },
          {
            "v": "S026/S027 raw capture exports store displayed MAC-address text; transformed sources may use an encoded/integer representation. Preserve the exact source-tab lexical value rather than treating representations as interchangeable.",
            "s": "10",
            "r": "D8"
          },
          {
            "v": "Example: `b8:ce:f6:5e:6b:4a` is a displayed captured sender address.",
            "s": "10",
            "r": "E8"
          },
          {
            "v": "A change can indicate a different observed flow or encoding, not an authorised role or physical identity.",
            "s": "10",
            "r": "F8"
          },
          {
            "v": "S026/S027 raw-capture tabs; transformed-source tabs retain their own encoding",
            "s": "10",
            "r": "G8"
          }
        ]
      },
