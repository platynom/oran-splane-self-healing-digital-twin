// Data model for the S-plane web simulator.
// Evidence tables (Scenario .. Fault) are written only by scripts/ingest.ts from the derived dataset that
// ingest/extract.py builds from the project's real run archives. Learner tables are written by the app.

generator client {
  provider      = "prisma-client-js"
  // native = the machine running `prisma generate` (local dev, Vercel build); musl = the Alpine container
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------ evidence (read-only in the app)

model Scenario {
  id              String  @id // e.g. "A1_rogue_master"
  code            String // e.g. "A1"
  cls             String // attack | benign | healthy | ambiguous
  title           String
  expectedVerdict String?
  source          String?
  destination     String?
  attackDevices   String?
  consequence     String?
  sortOrder       Int

  runs       Run[]
  aggregates ScenarioAggregate[]
  campaign   CampaignRun[]
}

model Run {
  id                    String   @id // e.g. "A1_rogue_master__r13__loop"
  scenarioId            String
  rep                   Int
  arm                   String // control | loop
  t0Mono                Float
  tStartRel             Float
  tEndRel               Float
  maintenanceWindowOpen Boolean
  params                Json
  state                 Json
  legitParents          String[]
  nftFinal              String
  standbyLogPresent     Boolean
  pcapAnchor            Json
  maxProvisionedAnnounceGapS Float?
  announceGaps          Json     @default("[]") // [[lastAnnounce, nextAnnounce|null], ...] gaps >= 0.4 s on the ports channel 2 watches

  // metrics recomputed by scripts/ingest.ts from the Sample rows (src/lib/metrics.ts)
  unhealthyS            Float
  ru3UnhealthyS         Float
  rogueParentS          Float
  restoredAtEnd         Boolean
  preT0ServiceOk        Float
  firstUnhealthyS       Float?
  outageS               Float?
  firstAttackVerdictS   Float?
  firstActionS          Float?

  scenario Scenario      @relation(fields: [scenarioId], references: [id])
  samples  Sample[]
  events   Event[]
  packets  PacketSeries?
  windows  RuleWindow[]

  @@unique([scenarioId, rep, arm])
  @@index([scenarioId])
}

// One pmc -d 24 poll of one RU by the passive observer (every 0.5 s), t relative to fault onset T0.
model Sample {
  id           Int     @id @default(autoincrement())
  runId        String
  round        Int
  tMono        Float // raw CLOCK_MONOTONIC stamp from observer.jsonl
  t            Float
  tRound       Float
  node         String // ru1 | ru2 | ru3
  portState    String?
  parent       String? // parent clockIdentity (16 hex)
  parentPort   String? // as printed by pmc, e.g. 020000.fffe.000001-2
  gm           String?
  gmClockClass Int?
  stepsRemoved Int?
  healthy      Boolean // PREREGISTRATION.md s4, computed at extraction and re-checked in tests

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, round])
}

// loop.jsonl (eval/act/would_act/verify/rollback/escalate/loop_start/loop_end) and ptp4l log lines.
model Event {
  id      Int      @id @default(autoincrement())
  runId   String
  t       Float
  tMono   Float? // raw CLOCK_MONOTONIC stamp (loop events only)
  source  String // loop | ptp4l
  kind    String
  node    String?
  verdict String?
  hint    String?
  action  String?
  target  String?
  ok      Boolean?
  detail  Json?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, t])
}

// Per-0.5 s PTP frame counts from the run's brDN / brUP captures: [segment, binStart, sender, msgType, count][]
model PacketSeries {
  runId String @id
  bins  Json
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// Frozen rule re-run offline on the recorded brDN capture at the live evaluation ticks (ingest/rule_windows.py).
model RuleWindow {
  id      Int    @id @default(autoincrement())
  runId   String
  window  Int // seconds
  seq     Json // [[t, verdict, hint], ...]
  run     Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, window])
}

model ScenarioAggregate {
  id                     Int      @id @default(autoincrement())
  scenarioId             String
  arm                    String
  n                      Int
  unhealthyMedian        Float
  unhealthyEach          Float[]
  restoredAtEnd          Int
  ru3UnhealthyEach       Float[]
  firstAttackVerdictEach Float[]
  firstActionEach        Float[]
  disruptiveExecuted     Int // ISOLATE / ACTIVATE_STANDBY_BC with kind "act"
  disruptiveWouldAct     Int // same actions logged as "would_act" (control arm)
  actionKinds            String[]
  verifyOk               Int
  verifyTotal            Int
  rollbacks              Int
  runsWithEscalation     Int

  scenario Scenario @relation(fields: [scenarioId], references: [id])

  @@unique([scenarioId, arm])
}

model CampaignRun {
  id          String  @id
  scenarioId  String
  rep         Int
  expected    String
  truthClass  String
  truthFault  String?
  description String?
  nPackets    Int?
  baseVerdict String
  baseHint    String?
  v2Verdict   String?
  v2Hint      String?
  v3Verdict   String
  v3Hint      String?
  v3Reason    String?

  scenario Scenario @relation(fields: [scenarioId], references: [id])
  evidence CampaignEvidence?
}

// Per-run evidence of the 168-run detector campaign: decision.json evidence block + counts computed from the run's deep CSV.
model CampaignEvidence {
  runId           String  @id
  csvRows         Int // rows in the deep CSV = PTP frames captured
  nPacketsClaimed Int? // evidence.n_packets in decision.json (checked equal to csvRows at extraction)
  nAnnounce       Int?
  captureSpanS    Float?
  msgTypeCounts   Json // message_type -> frames
  senderCounts    Json // eth_src (no colons) -> frames
  gmIdentities    Json // advertised grandmaster identity -> Announce count
  evidence        Json
  reasons         String[]
  description     String?

  run CampaignRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// 13 Sep pilot (software testbed): S11 closed-loop trials and S15 independent-validation trials.
model PilotRun {
  id             String   @id
  milestone      String // S11 | S15
  grp            String // S11: action | no_action; S15: jitter condition
  label          String? // S15: receiver dispersion label; S11: arm
  triggered      Boolean?
  actionExecuted Boolean?
  outcome        Boolean? // S11: receiver moved to the clean segment
  data           Json

  @@index([milestone])
}

model PilotSummary {
  id         String @id // S11 | S15
  status     String // PRESPECIFIED_BRANCH_MET | NOT_ESTABLISHED
  statement  String
  limits     Json
  data       Json
  sourcePath String
}

// B6 oscillator drift, two-laptop measurement (derived analysis output; raw per-sample CSVs are not in the repository).
model B6Measurement {
  id           String   @id // run1 | run2
  verdict      String // ESTABLISHED | NOT_ESTABLISHED
  relativePpm  Float
  ci95         Float[]
  halfwidthPpm Float
  armA         Json
  armB         Json
  stability    Json
  criteria     Json
  pairing      Json
  scopeLimits  Json
  rawCsvPresent Boolean
  sourcePath   String
  sourceSha256 String
}

model Fault {
  id              String  @id
  scenarioId      String?
  name            String
  cls             String
  kind            String // catalogue | campaign scenario
  source          String?
  destination     String?
  attackDevices   String?
  consequence     String?
  detectableNow   String?
  evidence        String?
  thresholdBasis  String?
  missing         String?
  mechanism       String?
  signature       String?
  reasoning       String?
  lookAlike       String?
  citations       String?
  testbedRequired String?
  threatId        String?
  sourceFile      String
}

model LookAlike {
  id            Int    @id @default(autoincrement())
  symptom       String
  benign        String
  attack        String
  discriminator String
  within2s      String?
  citations     String?
}

model DatasetInfo {
  id         Int      @id @default(1)
  provenance Json
  ingestedAt DateTime @default(now())
}

// ------------------------------------------------------------------ learners (NextAuth + guest)

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isGuest       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  xp            Int       @default(0)
  streak        Int       @default(0)
  lastActiveDay String? // YYYY-MM-DD (UTC)

  accounts Account[]
  sessions Session[]
  progress LessonProgress[]
}

model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  stepsCompleted String[]
  quizBest       Int       @default(0)
  quizTotal      Int       @default(3)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
