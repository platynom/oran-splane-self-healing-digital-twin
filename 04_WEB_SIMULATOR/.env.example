# --- Database -------------------------------------------------------------
# Local (docker compose): postgres on localhost:5433
DATABASE_URL="postgresql://splane:splane@localhost:5433/splane?schema=public"
# Neon / Supabase: DATABASE_URL = pooled connection string, DIRECT_URL = direct (non-pooled) string.
# Locally both are the same.
DIRECT_URL="postgresql://splane:splane@localhost:5433/splane?schema=public"

# --- Auth (NextAuth v4) ---------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
# Optional providers. Each provider is enabled only when its variables are set.
GITHUB_ID=""
GITHUB_SECRET=""
# Email magic link (any SMTP server), e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=""
EMAIL_FROM=""

# --- Live mode (localhost on Linux only) ------------------------------------
# URL of the FastAPI live service (live/server.py). Leave empty to disable live mode (always disabled on Vercel).
LIVE_SERVICE_URL=""
