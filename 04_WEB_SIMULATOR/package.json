{
  "name": "splane-web-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "O-RAN Open Fronthaul S-Plane timing security + recovery loop: replay of real runs, model sandbox and lessons",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "extract": "python3 ingest/extract.py",
    "db:push": "prisma db push --skip-generate",
    "db:ingest": "tsx scripts/ingest.ts",
    "db:setup": "prisma db push --skip-generate && tsx scripts/ingest.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fidelity": "tsx scripts/fidelity.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "next": "15.5.27",
    "next-auth": "4.24.15",
    "nodemailer": "7.0.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.8",
    "@types/nodemailer": "7.0.2",
    "@types/react": "19.1.15",
    "@types/react-dom": "19.1.9",
    "dotenv": "^16.5.0",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.27",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
