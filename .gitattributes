# Normalise line endings in the repository (LF in history, native in working tree).
# Without this, Windows CRLF churn marks ~74 text files "modified" immediately after
# every commit, creating permanent phantom dirt that repeatedly wasted agent cycles.
* text=auto

# Binary: never diff or line-ending-translate these (a text-mode PDF can be corrupted).
*.pdf  binary
*.pcap binary
*.pcapng binary
*.png  binary
*.pptx binary
*.xlsx binary
*.zip  binary

# Shell scripts and Dockerfiles must stay LF even on Windows checkouts: a CRLF docker-entrypoint.sh fails in the
# Linux container with "set: line 3: illegal option -".
*.sh text eol=lf
Dockerfile text eol=lf
